#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../test/dummy"

bundle check >/dev/null 2>&1 || bundle install
bundle exec rails db:prepare

echo ""
echo "Starting demo app at http://localhost:3000/csv_import"
echo ""
echo "Fixtures (from repo root test/fixtures/files/):"
echo "  contacts.csv       — 2 rows (sync import)"
echo "  contacts_large.csv — 55 rows (async import with Turbo progress)"
echo ""

bundle exec rails server
