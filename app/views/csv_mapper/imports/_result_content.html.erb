<%= turbo_frame_tag CsvMapper::ImportBroadcaster::FRAME_ID do %>
  <div class="card">
    <h1>Import Complete</h1>
    <p>Results for importing into <strong><%= model_name %></strong>.</p>

    <div class="stats">
      <div>
        <div class="stat-value" style="color: var(--success);"><%= result.success_count %></div>
        <div class="stat-label">Imported</div>
      </div>
      <div>
        <div class="stat-value" style="color: var(--error);"><%= result.failure_count %></div>
        <div class="stat-label">Failed</div>
      </div>
      <div>
        <div class="stat-value"><%= result.total_rows %></div>
        <div class="stat-label">Total Rows</div>
      </div>
    </div>

    <div class="actions">
      <%= link_to "Import Another File", new_import_path, class: "btn", data: { turbo_frame: "_top" } %>
    </div>
  </div>

  <% if result.errors.any? %>
    <div class="card">
      <h2>Errors</h2>
      <table>
        <thead>
          <tr>
            <th>Row</th>
            <th>Data</th>
            <th>Errors</th>
          </tr>
        </thead>
        <tbody>
          <% result.errors.each do |error| %>
            <tr>
              <td><%= error.row_number %></td>
              <td><code style="font-size:0.75rem;"><%= error.attributes.to_json %></code></td>
              <td style="color: var(--error);"><%= error.messages.join(", ") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
