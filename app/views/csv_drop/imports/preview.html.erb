<% content_for :title, "Map Fields" %>

<%= render "nav", current: :new %>

<div class="card">
  <h1>Map CSV Columns</h1>
  <p>
    Importing <strong><%= @row_count %></strong> rows into
    <strong><%= @model_name %></strong>.
    Match each CSV column to a model field, or skip it.
  </p>
  <% if @repeat_from.present? %>
    <p class="dry-run-notice">
      Column mapping restored from a previous import. Review fields below before importing.
    </p>
  <% end %>
</div>

<div class="card">
  <h2>Preview</h2>
  <table>
    <thead>
      <tr>
        <% @headers.each do |header| %>
          <th><%= header %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @preview_rows.each do |row| %>
        <tr>
          <% @headers.each do |header| %>
            <td><%= row[header.to_sym] || row[header] %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2>Column Mapping</h2>

  <%= form_with url: imports_path, method: :post, data: { turbo_frame: "_top" } do |f| %>
    <%= hidden_field_tag :token, @token %>

    <% @headers.each do |header| %>
      <div class="mapping-row">
        <div>
          <span class="csv-col"><%= header %></span>
        </div>
        <div>
          <%= select_tag "mapping[#{header}]",
                options_for_select(
                  [["— Skip this column —", CsvDrop::Mapper::SKIP]] +
                  @model_columns.map { |c|
                    label = c[:name]
                    label += " (required)" if c[:required]
                    [label, c[:name]]
                  },
                  @suggested_mappings[header]
                ),
                include_blank: (@repeat_from.blank? ? "Auto-detect…" : false),
                id: "mapping_#{header}" %>
        </div>
      </div>
    <% end %>

    <% if @duplicate_key_options.any? %>
      <div class="duplicate-options">
        <h3>Duplicate records</h3>
        <p>Match existing rows by a unique column, then choose what to do when a duplicate is found.</p>

        <div class="field">
          <label for="duplicate_key">Match on</label>
          <%= select_tag :duplicate_key,
                options_for_select([["— No duplicate detection —", ""]] + @duplicate_key_options.map { |key| [key, key] }, @duplicate_key),
                id: "duplicate_key" %>
        </div>

        <div class="field">
          <label for="duplicate_strategy">When duplicate found</label>
          <%= select_tag :duplicate_strategy,
                options_for_select([
                  ["Skip duplicate rows", "skip"],
                  ["Update existing records", "update"],
                  ["Fail duplicate rows", "fail"]
                ], @duplicate_strategy.presence || CsvDrop.config.default_duplicate_strategy),
                id: "duplicate_strategy" %>
        </div>
      </div>
    <% end %>

    <div class="actions">
      <%= submit_tag "Import #{@row_count} Rows", class: "btn" %>
      <%= button_tag "Preview Import",
            type: "submit",
            formaction: dry_run_imports_path,
            formmethod: "post",
            class: "btn btn-secondary" %>
      <%= link_to "Start Over", new_import_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
