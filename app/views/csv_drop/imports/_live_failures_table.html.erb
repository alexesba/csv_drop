<% if rows.any? %>
  <div class="card live-failures-card">
    <h2><%= title %></h2>
    <p class="live-failures-hint"><%= hint %></p>

    <div class="table-scroll">
      <table class="results-table">
        <thead>
          <tr>
            <th>Row</th>
            <% column_headers.each do |header| %>
              <th><%= header %></th>
            <% end %>
            <th>Errors</th>
          </tr>
        </thead>
        <tbody id="csv_drop_live_failures">
          <% rows.each do |row| %>
            <tr class="row-failed">
              <td><%= row.row_number %></td>
              <% column_headers.each do |header| %>
                <td><%= row.values[header] %></td>
              <% end %>
              <td class="error-cell"><%= row.messages.join(", ") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
