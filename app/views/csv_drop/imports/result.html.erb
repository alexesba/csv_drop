<% content_for :title, @dry_run ? "Dry Run Results" : "Import Results" %>

<%= render "nav", current: :history %>

<%= render "result_content",
  result: @result,
  model_name: @model_name,
  import_id: @import_id,
  import_results: @import_results,
  dry_run: @dry_run,
  session_token: @session_token,
  mapping: @mapping,
  duplicate_key: @duplicate_key,
  duplicate_strategy: @import[:duplicate_strategy] %>
