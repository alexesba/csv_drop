<% content_for :title, "New Import" %>

<%= render "nav", current: :new %>

<div class="card">
  <h1>Drop a CSV</h1>
  <p>Drag and drop a CSV file, then choose which model to populate.</p>

  <%= form_with url: preview_imports_path, method: :post, multipart: true, data: { turbo_frame: "_top" } do |f| %>
    <div class="field">
      <%= label_tag :csv_file, "CSV File" %>
      <div class="drop-zone" id="csv-drop-zone" tabindex="0" aria-label="Drop CSV file here or click to browse">
        <%= file_field_tag :csv_file, accept: ".csv,text/csv", required: true, class: "drop-zone-input", id: "csv_file" %>
        <div class="drop-zone-content">
          <div class="drop-zone-icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 16V4m0 0l-4 4m4-4l4 4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M4 14v4a2 2 0 002 2h12a2 2 0 002-2v-4" stroke-linecap="round"/>
            </svg>
          </div>
          <p class="drop-zone-title">Drop your CSV here</p>
          <p class="drop-zone-hint">or click to browse</p>
          <p class="drop-zone-filename" hidden></p>
        </div>
      </div>
    </div>

    <div class="field">
      <%= label_tag :model_name, "Target Model" %>
      <% if @importable_models.any? %>
        <%= select_tag :model_name,
              options_for_select(@importable_models),
              prompt: "Select a model…",
              required: true %>
      <% else %>
        <p>No importable models found. Make sure your app has ActiveRecord models with database tables.</p>
      <% end %>
    </div>

    <% if @importable_models.any? %>
      <%= submit_tag "Continue to Field Mapping", class: "btn" %>
    <% end %>
  <% end %>
</div>

<script>
  function initCsvDropZone() {
    const zone = document.getElementById("csv-drop-zone");
    const input = document.getElementById("csv_file");
    if (!zone || !input) return;

    const filename = zone.querySelector(".drop-zone-filename");
    const hint = zone.querySelector(".drop-zone-hint");
    const title = zone.querySelector(".drop-zone-title");

    const isCsv = (file) =>
      file.name.toLowerCase().endsWith(".csv") || file.type === "text/csv";

    const showFile = (file) => {
      filename.textContent = file.name;
      filename.hidden = false;
      title.textContent = "Ready to import";
      hint.textContent = "Click or drop to replace";
      zone.classList.add("has-file");
    };

    input.addEventListener("change", () => {
      if (input.files[0]) showFile(input.files[0]);
    });

    zone.addEventListener("dragover", (event) => {
      event.preventDefault();
      zone.classList.add("drag-over");
    });

    zone.addEventListener("dragleave", (event) => {
      if (!zone.contains(event.relatedTarget)) {
        zone.classList.remove("drag-over");
      }
    });

    zone.addEventListener("drop", (event) => {
      event.preventDefault();
      zone.classList.remove("drag-over");

      const file = event.dataTransfer.files[0];
      if (!file) return;

      if (!isCsv(file)) {
        window.alert("Please drop a CSV file.");
        return;
      }

      const transfer = new DataTransfer();
      transfer.items.add(file);
      input.files = transfer.files;
      showFile(file);
    });

    zone.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        input.click();
      }
    });
  }

  document.addEventListener("turbo:load", initCsvDropZone);
  document.addEventListener("DOMContentLoaded", initCsvDropZone);
</script>
