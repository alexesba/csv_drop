<%= turbo_frame_tag CsvDrop::ImportBroadcaster::FRAME_ID do %>
  <div class="card">
    <% if dry_run %>
      <h1>Dry Run Complete</h1>
      <p class="dry-run-notice">
        Validation preview for <strong><%= model_name %></strong> — no records were saved.
      </p>
    <% else %>
      <h1>Import Complete</h1>
      <p>Results for importing into <strong><%= model_name %></strong>.</p>
    <% end %>

    <div class="stats">
      <% if duplicate_key.present? %>
        <% unless dry_run %>
          <div>
            <div class="stat-value" style="color: var(--success);"><%= result.imported_count %></div>
            <div class="stat-label">Imported</div>
          </div>
          <% if result.updated_count.positive? %>
            <div>
              <div class="stat-value" style="color: var(--primary);"><%= result.updated_count %></div>
              <div class="stat-label">Updated</div>
            </div>
          <% end %>
        <% else %>
          <div>
            <div class="stat-value" style="color: var(--success);"><%= result.success_count %></div>
            <div class="stat-label">Valid</div>
          </div>
        <% end %>
        <% if result.skipped_count.positive? %>
          <div>
            <div class="stat-value" style="color: var(--muted);"><%= result.skipped_count %></div>
            <div class="stat-label">Skipped</div>
          </div>
        <% end %>
      <% else %>
        <div>
          <div class="stat-value" style="color: var(--success);"><%= result.success_count %></div>
          <div class="stat-label"><%= dry_run ? "Valid" : "Imported" %></div>
        </div>
      <% end %>
      <div>
        <div class="stat-value" style="color: var(--error);"><%= result.failure_count %></div>
        <div class="stat-label">Failed</div>
      </div>
      <div>
        <div class="stat-value"><%= result.total_rows %></div>
        <div class="stat-label">Total Rows</div>
      </div>
    </div>

    <div class="actions">
      <% if dry_run && session_token.present? %>
        <%= form_with url: imports_path, method: :post, data: { turbo_frame: "_top" } do %>
          <%= hidden_field_tag :token, session_token %>
          <% mapping.each do |column, attribute| %>
            <%= hidden_field_tag "mapping[#{column}]", attribute %>
          <% end %>
          <% if duplicate_key.present? %>
            <%= hidden_field_tag :duplicate_key, duplicate_key %>
            <%= hidden_field_tag :duplicate_strategy, local_assigns[:duplicate_strategy] %>
          <% end %>
          <%= submit_tag "Import #{result.total_rows} Rows", class: "btn" %>
        <% end %>
        <%= link_to "Adjust Mapping",
          mapping_imports_path(token: session_token),
          class: "btn btn-secondary",
          data: { turbo_frame: "_top" } %>
      <% end %>
      <% if result.failure_count.positive? %>
        <%= link_to "Download Failed Rows",
          rejects_import_path(import_id),
          class: "btn btn-secondary",
          data: { turbo: false } %>
      <% end %>
      <%= link_to "Repeat Mapping", repeat_import_path(import_id), class: "btn btn-secondary", data: { turbo_frame: "_top" } %>
      <%= link_to "Import Another File", new_import_path, class: "btn btn-secondary", data: { turbo_frame: "_top" } %>
    </div>
  </div>

  <%= render "csv_drop/imports/import_rows_table",
    result: result,
    import_results: import_results,
    import_id: import_id,
    dry_run: dry_run %>
<% end %>
