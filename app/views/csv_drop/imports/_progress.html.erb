<%= turbo_frame_tag CsvDrop::ImportBroadcaster::FRAME_ID do %>
  <div class="card">
    <h1>Importing…</h1>
    <p>
      Processing rows for <strong><%= import[:model_name] %></strong>.
    </p>

    <% percent = import[:total_rows].positive? ? (import[:processed_rows] * 100.0 / import[:total_rows]).round : 0 %>

    <div class="progress-bar" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100">
      <div class="progress-bar-fill" style="width: <%= percent %>%"></div>
    </div>

    <div class="stats">
      <div>
        <div class="stat-value"><%= import[:processed_rows] %> / <%= import[:total_rows] %></div>
        <div class="stat-label">Rows processed</div>
      </div>
      <div>
        <div class="stat-value" style="color: var(--success);"><%= import[:success_count] %></div>
        <div class="stat-label">Imported</div>
      </div>
      <div>
        <div class="stat-value" style="color: var(--error);"><%= import[:failure_count] %></div>
        <div class="stat-label">Failed</div>
      </div>
    </div>

    <p class="import-status-label">
      Status: <strong><%= import[:status].humanize %></strong>
    </p>
  </div>

  <% if local_assigns[:live_failures] && live_failures.rows.any? %>
    <%= render "csv_drop/imports/live_failures_table",
      column_headers: live_failures.column_headers,
      rows: live_failures.rows,
      title: "Failures so far",
      hint: "Failed rows appear here as they are detected. Successful rows are counted above." %>
  <% end %>
<% end %>
